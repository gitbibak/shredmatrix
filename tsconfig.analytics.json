{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "types": ["vite/client"]
  },
  "include": [
    "src/lib/analytics.js",
    "src/lib/analyticsEventSchema.js",
    "src/lib/analyticsTypes.d.ts",
    "src/lib/acquisition.js"
  ]
}
