{
  "rewrites": [
    { "source": "/blog", "destination": "/blog/index.html" },
    { "source": "/blog/:slug", "destination": "/blog/:slug/index.html" },
    { "source": "/editorial-policy", "destination": "/editorial-policy/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
